{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["src/dashboard/vendor/**", "dist/**", "coverage/**"],
  "rules": {
    "no-eval": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "typescript/no-extraneous-class": "off",
    "promise/prefer-await-to-then": "error",
    "no-underscore-dangle": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/no-array-sort": "warn",
    "max-lines-per-function": ["warn", { "max": 30, "skipComments": true, "skipBlankLines": true }],
    "max-params": ["warn", { "max": 3 }],
    "max-lines": ["warn", { "max": 200, "skipComments": true, "skipBlankLines": true }],
    "max-depth": ["warn", { "max": 4 }],
    "max-nested-callbacks": ["error", { "max": 3 }]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "src/tests/**"],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off",
        "max-nested-callbacks": "off",
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": ["src/modules/**/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/usecases/**",
              "**/interface-adapters/**",
              "**/frameworks/**",
              "**/main/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/**/usecases/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["**/interface-adapters/**", "**/frameworks/**", "**/main/**"]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["**/modules/**", "**/frameworks/**", "**/main/**"]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true,
    "node": true,
    "es2024": true
  }
}
