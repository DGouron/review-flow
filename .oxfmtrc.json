{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": true,
  "ignorePatterns": ["dist", "coverage", "node_modules", "src/dashboard/vendor", "**/*.html", "**/*.css"]
}
